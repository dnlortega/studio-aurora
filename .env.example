# ---------------------------------------------------------------------------
# Studio Aurora — variáveis de ambiente
# Copie este arquivo para `.env.local` (desenvolvimento) ou configure no host.
# NUNCA versione o .env.local nem credenciais reais.
# ---------------------------------------------------------------------------

# Banco de dados.
# Em desenvolvimento, deixe DATABASE_URL vazio: o app usa PostgreSQL embutido
# (PGlite) em ./.data/pglite. Em produção, informe uma URL PostgreSQL, ex.:
# DATABASE_URL=postgres://usuario:senha@host:5432/banco?sslmode=require
DATABASE_URL=

# Diretório do banco embutido (usado apenas quando DATABASE_URL não existe).
PGLITE_DIR=.data/pglite

# Executa migrações automaticamente ao iniciar (recomendado apenas em dev).
# Em produção rode `npm run db:migrate` antes de subir a aplicação.
DB_AUTO_MIGRATE=true

# Segredo usado para assinar/derivar dados auxiliares de sessão (mín. 32 chars).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Notificações por e-mail (opcional). Sem a chave, o sistema registra a
# notificação como "não configurada" e NÃO finge que enviou.
RESEND_API_KEY=
EMAIL_FROM="Studio Aurora <agenda@seudominio.com>"

# URL pública usada em links de recuperação de senha e no painel de status.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Endereço do repositório no GitHub (opcional). Aparece em /admin/status como
# "Origem do código". Na Vercel o próprio deploy já informa dono e repositório,
# então defina aqui apenas para ver o link fora da Vercel.
NEXT_PUBLIC_REPOSITORY_URL=https://github.com/dnlortega/studio-aurora

# Primeiro administrador (usado apenas pelo seed de demonstração).
# Em produção, crie o admin com `npm run admin:create` e não use o seed demo.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
