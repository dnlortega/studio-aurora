# ---------------------------------------------------------------------------
# Studio Aurora — variáveis de ambiente
# Copie este arquivo para `.env.local` (desenvolvimento) ou configure no host.
# NUNCA versione o .env.local nem credenciais reais.
# ---------------------------------------------------------------------------

# Banco de dados — obrigatório, sem alternativa local.
# O Studio Aurora fala exclusivamente com PostgreSQL externo (Neon). Sem esta
# variável o app, os testes e o seed recusam rodar.
# DATABASE_URL=postgres://usuario:senha@host:5432/banco?sslmode=require
DATABASE_URL=

# Bancos de teste, no MESMO projeto Neon. Não precisam ser definidos: os scripts
# derivam do DATABASE_URL trocando só o nome do banco (aurora_test para o
# Vitest, aurora_e2e para o Playwright) e os criam se ainda não existirem.
# Defina apenas se quiser host ou banco diferentes — o nome do banco precisa ser
# exatamente aurora_test / aurora_e2e, ou as guards recusam o reset.
# TEST_DATABASE_URL=
# E2E_DATABASE_URL=

# Executa migrações ao abrir o banco. O padrão é false: migração é tarefa do
# `npm run db:migrate` (e dos scripts de teste), não do cold start serverless.
DB_AUTO_MIGRATE=false

# Segredo usado para assinar/derivar dados auxiliares de sessão (mín. 32 chars).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Notificações por e-mail (opcional). Sem a chave, o sistema registra a
# notificação como "não configurada" e NÃO finge que enviou.
RESEND_API_KEY=
EMAIL_FROM="Studio Aurora <agenda@seudominio.com>"

# URL pública usada em links de recuperação de senha e no painel de status.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Endereço do repositório no GitHub (opcional). Aparece em /admin/status como
# "Origem do código". Na Vercel o próprio deploy já informa dono e repositório,
# então defina aqui apenas para ver o link fora da Vercel.
NEXT_PUBLIC_REPOSITORY_URL=https://github.com/dnlortega/studio-aurora

# Origens liberadas no HMR do `next dev`, separadas por vírgula. Precisa estar
# certo quando você abre o app pelo IP da rede local (celular/tablet); sem isso
# o navegador congela na versão antiga do HTML. Padrão: 172.20.187.11.
# DEV_ORIGINS=172.20.187.11,192.168.0.10

# Contas de demonstração criadas pelo `npm run db:seed`.
# Não existe variável de senha aqui: o seed gera uma senha forte, usa para criar
# o hash no banco e mostra o valor uma única vez no terminal. Em produção, crie
# o administrador com `npm run admin:create` (ele pergunta a senha).
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_CLIENT_NAME=
SEED_CLIENT_EMAIL=
# SEED_DEMO_APPOINTMENTS=false desliga os agendamentos de exemplo do seed.
SEED_DEMO_APPOINTMENTS=true
